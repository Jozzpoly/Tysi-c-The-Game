{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tysiac-the-game",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_CANARY",
        "class_name": "MatchCanary"
      },
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchCanary"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ]
}
